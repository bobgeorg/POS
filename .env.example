# Restaurant POS Environment Configuration

# ============================================
# HTTP/HTTPS Configuration
# ============================================
# Set USE_HTTPS to true to enable HTTPS for local development
USE_HTTPS=false
HTTPS_PORT=5443
PORT=5000

# ============================================
# Database Configuration
# ============================================
# MongoDB Connection String
# Default: Local MongoDB instance
MONGO_URI=mongodb://localhost:27017/restaurant-pos

# MongoDB Atlas (Cloud) Example:
# MONGO_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/restaurant-pos?retryWrites=true&w=majority

# MongoDB with Authentication Example:
# MONGO_URI=mongodb://username:password@localhost:27017/restaurant-pos

# ============================================
# Instructions
# ============================================
# 1. Copy this file to .env
# 2. Update MONGO_URI with your database connection string
# 3. For HTTPS mode, generate certificates (see HTTPS_SETUP.md)
# 4. For network access, ensure client/.env has correct API_URL

